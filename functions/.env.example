# Copy to functions/.env and fill in. These are NOT secrets.
# Secrets (PROFJERO_API_KEY, CLOUDINARY_API_SECRET) are set with:
#   firebase functions:secrets:set PROFJERO_API_KEY
#   firebase functions:secrets:set CLOUDINARY_API_SECRET
APP_URL=https://area-supa-ventures.web.app
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
