{
  "name": "area-supa-ventures",
  "private": true,
  "description": "Area Supa Ventures susu collection web app",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i web-src/app.css -o \"Area Supa Ventres/assets/app.css\" --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i web-src/app.css -o \"Area Supa Ventres/assets/app.css\" --watch",
    "build": "npm run build:css && node scripts/stamp-sw.js",
    "deploy": "npm run build && firebase deploy"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.19"
  }
}